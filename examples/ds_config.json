{
  "train_micro_batch_size_per_gpu": 8,
  "gradient_accumulation_steps": 2,
  "gradient_clipping": 1.0,
  "dtype": "fp16",
  "fp16": {
    "enabled": true,
    "loss_scale": 0,
    "initial_scale_power": 16,
    "loss_scale_window": 200
  },
  "optimizer": {
    "type": "AdamW",
    "params": {
      "lr": 0.003,
      "betas": [0.9, 0.95],
      "eps": 1e-8,
      "weight_decay": 0.1
    }
  },
  "scheduler": {
    "type": "WarmupDecayLR",
    "params": {
      "warmup_min_lr": 0.0003,
      "warmup_max_lr": 0.003,
      "warmup_num_steps": 30,
      "total_num_steps": 300
    }
  },
  "zero_optimization": {
    "stage": 2
  },
  "steps_per_print": 25
}
